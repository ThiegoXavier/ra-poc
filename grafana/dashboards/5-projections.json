        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "rawSql": "SELECT projected_revenue AS \"Projected\" FROM ra_projection ORDER BY cycle_code LIMIT 1;",
          "format": "table",
          "refId": "A",
          "hide": false,
          "datasource": {
            "type": "postgres",
            "uid": "ra-postgres"
          }
        }
