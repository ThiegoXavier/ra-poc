            "mode": "fixed",
            "fixedColor": "#1E88E5"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1E88E5",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) AS \"Offers\" FROM offer WHERE offer_type LIKE '${offer_type}';",
          "format": "table",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "postgres",
        "uid": "ra-postgres"
