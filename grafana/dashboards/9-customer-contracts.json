                    "options": {
                      "PLAN": {
                        "color": "#1E88E5"
                      },
                      "ADDON": {
                        "color": "#43A047"
                      },
                      "PROMO": {
                        "color": "#FB8C00"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ACTIVE": {
                        "color": "#43A047"
                      },
                      "SUSPENDED": {
                        "color": "#FB8C00"
                      },
