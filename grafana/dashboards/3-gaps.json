                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "GAP_OVERCHARGE": {
                        "text": "\ud83d\udd34 Overcharge"
                      },
                      "GAP_UNDERCHARGE": {
                        "text": "\ud83d\udfe0 Undercharge"
                      },
                      "GAP_MISSING": {
                        "text": "\ud83d\udfe3 Missing"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Difference",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "rawSql": "SELECT bc.cycle_code AS \"Cycle\", c.customer_code AS \"Customer\", c.customer_name AS \"Name\", o.offer_name AS \"Offer\", r.status AS \"Type\", r.expected_amount AS \"Expected\", r.billed_amount AS \"Billed\", ABS(COALESCE(r.difference, r.expected_amount)) AS \"Difference\", r.justification AS \"Justification\" FROM ra_result r JOIN ra_run rr ON rr.run_id=r.run_id JOIN billing_cycle bc ON bc.cycle_id=rr.cycle_id JOIN customer c ON c.customer_id=r.customer_id JOIN contract ct ON ct.contract_id=r.contract_id JOIN offer o ON o.offer_id=ct.offer_id WHERE r.status LIKE '$gap_type' AND bc.cycle_code LIKE '$cycle' AND c.customer_code LIKE '$customer' ORDER BY ABS(COALESCE(r.difference, r.expected_amount)) DESC LIMIT 200;",
          "format": "table",
          "refId": "A",
          "hide": false,
          "datasource": {
            "type": "postgres",
            "uid": "ra-postgres"
          }
        }
      ],
      "datasource": {
        "type": "postgres",
        "uid": "ra-postgres"
      },
      "id": 7
    },
    {
      "type": "barchart",
      "title": "\ud83c\udfc6 Top 10 Customers by Gap Value",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 17
