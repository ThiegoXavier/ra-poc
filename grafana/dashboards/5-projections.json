      },
      "id": 3
    },
    {
      "type": "barchart",
      "title": "Actual vs Projected Revenue",
      "description": "Solid = actual, dashed = projected, shaded = confidence band",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Actual"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#1E88E5"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Projected"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#43A047"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Optimistic (+10%)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#66BB6A"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dot"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pessimistic (-15%)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#EF5350"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dot"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 8
              },
              {
                "id": "custom.fillBelowTo",
                "value": "Optimistic (+10%)"
              }
            ]
          }
        ]
      },
      "options": {
        "xTickLabelRotation": -45,
        "showValue": "auto",
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "rawSql": "SELECT bc.cycle_code AS \"Cycle\", SUM(i.total_amount) AS \"Actual\" FROM billing_cycle bc JOIN invoice i ON i.cycle_id=bc.cycle_id GROUP BY bc.cycle_code ORDER BY bc.cycle_code;",
          "format": "table",
          "refId": "A",
          "hide": false,
          "datasource": {
            "type": "postgres",
            "uid": "ra-postgres"
          }
        },
        {
          "rawSql": "SELECT cycle_code AS \"Cycle\", projected_revenue AS \"Projected\", projected_revenue*1.10 AS \"Optimistic (+10%)\", projected_revenue*0.85 AS \"Pessimistic (-15%)\" FROM ra_projection ORDER BY cycle_code;",
          "format": "table",
          "refId": "B",
          "hide": false,
          "datasource": {
            "type": "postgres",
            "uid": "ra-postgres"
          }
        }
      ],
      "datasource": {
        "type": "postgres",
        "uid": "ra-postgres"
      },
      "id": 4
    },
    {
      "type": "barchart",
      "title": "Monthly Cancellations",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#E53935"
          }
        },
        "overrides": []
      },
      "options": {
        "xTickLabelRotation": -45,
        "showValue": "auto",
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "rawSql": "SELECT TO_CHAR(end_date,'YYYY-MM') AS \"Month\", COUNT(*) AS \"Cancellations\" FROM contract WHERE status IN ('CANCELLED','EXPIRED') AND end_date IS NOT NULL GROUP BY TO_CHAR(end_date,'YYYY-MM') ORDER BY \"Month\";",
          "format": "table",
          "refId": "A",
          "hide": false,
          "datasource": {
            "type": "postgres",
            "uid": "ra-postgres"
          }
        }
      ],
      "datasource": {
        "type": "postgres",
        "uid": "ra-postgres"
      },
      "id": 5
    },
    {
      "type": "barchart",
      "title": "Monthly New Activations",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#43A047"
          }
        },
        "overrides": []
      },
      "options": {
        "xTickLabelRotation": -45,
        "showValue": "auto",
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "rawSql": "SELECT TO_CHAR(start_date,'YYYY-MM') AS \"Month\", COUNT(*) AS \"Activations\" FROM contract WHERE start_date>='2025-01-01' GROUP BY TO_CHAR(start_date,'YYYY-MM') ORDER BY \"Month\";",
          "format": "table",
          "refId": "A",
          "hide": false,
          "datasource": {
            "type": "postgres",
            "uid": "ra-postgres"
          }
        }
      ],
      "datasource": {
        "type": "postgres",
        "uid": "ra-postgres"
      },
      "id": 6
    },
    {
      "type": "barchart",
      "title": "\u23f3 Revenue at Risk \u2014 Loyalty Expiration",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "#FB8C00"
          }
        },
        "overrides": []
      },
      "options": {
        "xTickLabelRotation": -45,
        "showValue": "auto",
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "rawSql": "SELECT TO_CHAR(c.start_date+(c.loyalty_months||' months')::interval,'YYYY-MM') AS \"Expiry\", SUM(o.base_price) AS \"At Risk\", COUNT(*) AS \"Contracts\" FROM contract c JOIN offer o ON o.offer_id=c.offer_id WHERE c.status='ACTIVE' AND c.loyalty_months>0 AND c.start_date+(c.loyalty_months||' months')::interval>=NOW() GROUP BY \"Expiry\" ORDER BY \"Expiry\";",
          "format": "table",
          "refId": "A",
          "hide": false,
          "datasource": {
            "type": "postgres",
            "uid": "ra-postgres"
          }
        }
      ],
      "datasource": {
        "type": "postgres",
        "uid": "ra-postgres"
      },
      "id": 7
    },
    {
      "type": "table",
      "title": "Projection Details",
      "gridPos": {
        "h": 7,
