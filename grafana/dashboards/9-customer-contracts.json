      },
      "targets": [
        {
          "rawSql": "SELECT COALESCE(SUM(o.base_price),0) AS \"Total\" FROM contract c JOIN offer o ON o.offer_id=c.offer_id JOIN customer cu ON cu.customer_id=c.customer_id WHERE cu.customer_code='${customer}' AND c.status='ACTIVE';",
          "format": "table",
          "refId": "A"
