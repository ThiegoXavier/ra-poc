            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pessimistic"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Avg Ticket"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "rawSql": "SELECT cycle_code AS \"Cycle\", projected_revenue AS \"Projected\", ROUND(projected_revenue*1.10,2) AS \"Optimistic\", ROUND(projected_revenue*0.85,2) AS \"Pessimistic\", active_contracts AS \"Contracts\", avg_ticket AS \"Avg Ticket\" FROM ra_projection ORDER BY cycle_code;",
          "format": "table",
          "refId": "A",
          "hide": false,
          "datasource": {
            "type": "postgres",
            "uid": "ra-postgres"
          }
        }
