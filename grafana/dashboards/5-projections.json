  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Last Month Revenue",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "#1E88E5"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1E88E5",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "rawSql": "SELECT SUM(i.total_amount) AS \"Revenue\" FROM invoice i JOIN billing_cycle bc ON bc.cycle_id=i.cycle_id WHERE bc.cycle_code=(SELECT MAX(cycle_code) FROM billing_cycle);",
          "format": "table",
          "refId": "A",
          "hide": false,
          "datasource": {
            "type": "postgres",
            "uid": "ra-postgres"
          }
        }
      ],
      "datasource": {
        "type": "postgres",
        "uid": "ra-postgres"
      },
      "id": 1
    },
