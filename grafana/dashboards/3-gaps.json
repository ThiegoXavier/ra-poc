          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "rawSql": "SELECT c.customer_code AS \"Customer\", ROUND(SUM(ABS(COALESCE(r.difference, r.expected_amount)))::numeric,2) AS \"Gap Value\" FROM ra_result r JOIN customer c ON c.customer_id=r.customer_id JOIN ra_run rr ON rr.run_id=r.run_id JOIN billing_cycle bc ON bc.cycle_id=rr.cycle_id WHERE r.status LIKE '$gap_type' AND bc.cycle_code LIKE '$cycle' AND c.customer_code LIKE '$customer' GROUP BY c.customer_code ORDER BY \"Gap Value\" DESC LIMIT 10;",
          "format": "table",
          "refId": "A",
          "hide": false,
          "datasource": {
            "type": "postgres",
            "uid": "ra-postgres"
          }
        }
