          "rawSql": "SELECT bc.cycle_code AS \"Cycle\", SUM(CASE WHEN r.status='MATCH' THEN 1 ELSE 0 END) AS \"Match\", SUM(CASE WHEN r.status='JUSTIFIED' THEN 1 ELSE 0 END) AS \"Justified\", SUM(CASE WHEN r.status LIKE 'GAP_%' THEN 1 ELSE 0 END) AS \"Gap\" FROM ra_result r JOIN ra_run rr ON rr.run_id=r.run_id JOIN billing_cycle bc ON bc.cycle_id=rr.cycle_id JOIN customer cu ON cu.customer_id=r.customer_id WHERE cu.customer_code='${customer}' GROUP BY bc.cycle_code ORDER BY bc.cycle_code;",
