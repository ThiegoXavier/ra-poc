      "type": "table",
      "title": "\ud83d\udd0d Anomaly Detection Comparison (Z-Score vs Autoencoder)",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Z-Score Anomalies"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
