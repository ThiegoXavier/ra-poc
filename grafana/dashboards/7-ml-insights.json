              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "YES": {
                        "color": "#E53935"
                      },
                      "no": {
                        "color": "#43A047"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "rawSql": "SELECT a.cycle_code AS \"Cycle\", ROUND(a.reconstruction_error::numeric, 6) AS \"AE Error\", ROUND(a.threshold::numeric, 6) AS \"AE Threshold\", CASE WHEN a.is_anomaly THEN 'YES' ELSE 'no' END AS \"AE Anomaly\", (SELECT COUNT(*) FROM ml_anomaly z WHERE z.cycle_code = a.cycle_code AND z.is_anomaly) AS \"Z-Score Anomalies\" FROM ml_autoencoder_anomaly a ORDER BY a.cycle_code;",
          "format": "table",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "postgres",
        "uid": "ra-postgres"
