      "type": "stat",
      "title": "Avg Ticket",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "#8E24AA"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8E24AA",
                "value": null
              }
            ]
          }
        }
