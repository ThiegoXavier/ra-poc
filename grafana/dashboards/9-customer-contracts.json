      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Start",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "rawSql": "SELECT c.contract_code AS \"Contract\", o.offer_code AS \"Offer Code\", o.offer_name AS \"Offer\", o.offer_type AS \"Type\", o.base_price AS \"List Price\", c.status AS \"Status\", c.start_date AS \"Start\", c.end_date AS \"End\", c.loyalty_months AS \"Loyalty (mo)\", c.discount_pct AS \"Discount %\" FROM contract c JOIN offer o ON o.offer_id=c.offer_id JOIN customer cu ON cu.customer_id=c.customer_id WHERE cu.customer_code='${customer}' ORDER BY c.start_date;",
          "format": "table",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "postgres",
        "uid": "ra-postgres"
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "\u2699\ufe0f Pricing Rules for this Customer's Offers",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Rule Type"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "BASE_PRICE": {
                        "color": "#1E88E5"
                      },
                      "LOYALTY_DISCOUNT": {
                        "color": "#43A047"
                      },
                      "PROMO_DISCOUNT": {
                        "color": "#FB8C00"
                      },
                      "COMBO_DISCOUNT": {
                        "color": "#8E24AA"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Applies?"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "YES": {
                        "color": "#43A047"
                      },
                      "no": {
                        "color": "#9E9E9E"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Contract",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "rawSql": "SELECT c.contract_code AS \"Contract\", o.offer_name AS \"Offer\", r.rule_type AS \"Rule Type\", CASE WHEN r.value_type='PERCENT' THEN r.rule_value || '%' ELSE '$' || r.rule_value END AS \"Value\", COALESCE(r.min_months::text,'-') AS \"Min Months\", COALESCE(r.max_months::text,'-') AS \"Max Months\", r.description AS \"Description\", CASE WHEN r.rule_type='BASE_PRICE' THEN 'YES' WHEN r.rule_type='LOYALTY_DISCOUNT' AND c.loyalty_months >= r.min_months THEN 'YES' WHEN r.rule_type='LOYALTY_DISCOUNT' THEN 'no' ELSE 'YES' END AS \"Applies?\" FROM contract c JOIN offer o ON o.offer_id=c.offer_id JOIN offer_rule r ON r.offer_id=o.offer_id JOIN customer cu ON cu.customer_id=c.customer_id WHERE cu.customer_code='${customer}' ORDER BY c.contract_code, r.rule_type;",
          "format": "table",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "postgres",
        "uid": "ra-postgres"
      }
    }
